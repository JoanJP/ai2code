<mvc:View controllerName="project.fiori.controller.TreeNavigation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Toolbar>
        <Title text = "Context"/>
    </Toolbar>
    <Tree id="contextTree" items="{ path: 'tree>/nodes', parameters: { arrayNames: ['children'] } }">
        <StandardTreeItem title="{tree>key}"/>
    </Tree>
</mvc:View>